<Window x:Class="WaterSystem.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WaterSystem.Wpf.Binding"
        xmlns:controls="clr-namespace:WaterSystem.Wpf.Controls"
        Title="智能水箱上位机"
        Width="1492" Height="1000"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BgWindow}"
        FontFamily="微软雅黑">
    <Viewbox Stretch="Uniform">
        <!-- 设计稿画布 1492×1000（Q1=B：Viewbox 等比缩放至工作区） -->
        <Canvas Width="1492" Height="1000">

            <!-- ═══ 顶栏状态带 (0,0,1492,40) ═══ -->
            <Grid Canvas.Left="0" Canvas.Top="0" Width="1492" Height="40"
                  Background="{DynamicResource BgCard}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="智能水箱上位机" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="蓄水池 · 3 台水泵 · 阀门组监控" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" Margin="12,3,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <!-- 通信 Chip（P13：状态永可见） -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="360,0,0,0">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Off}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnToneKey}" Value="Ok">
                                        <Setter Property="Fill" Value="{DynamicResource Ok}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnToneKey}" Value="Alarm">
                                        <Setter Property="Fill" Value="{DynamicResource Alarm}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnToneKey}" Value="Accent">
                                        <Setter Property="Fill" Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnStateText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
                <!-- 未确认报警徽标（P4/P12：AlarmCenter 计数上顶栏，点击聚焦报警卡） -->
                <controls:AlarmBadgeChip VerticalAlignment="Center" Margin="680,0,0,0"
                                         Text="{Binding UnackBadgeText}"
                                         Tone="{Binding UnackBadgeTone}"
                                         Cursor="Hand"
                                         MouseLeftButtonUp="UnackBadge_Click" />
                <!-- 系统说明按钮（ⓘ 图标，时钟左侧，设计书 §2.1 & T4.10） -->
                <Button Content="ⓘ" Width="26" Height="26" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,170,0" Background="Transparent"
                        BorderThickness="0" Foreground="{DynamicResource TextSecondary}"
                        FontSize="15" FontWeight="SemiBold" ToolTip="系统说明与陌生人指南"
                        Click="SystemInfoButton_Click" Cursor="Hand" />
                <TextBlock Text="{Binding ClockText}" FontSize="14"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,90,0"
                           HorizontalAlignment="Right" />
                <Button Content="✕" Width="32" Height="32" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,8,0" Background="Transparent"
                        BorderThickness="0" Foreground="{DynamicResource TextSecondary}"
                        FontSize="13" Click="CloseButton_Click" />
            </Grid>

            <!-- ═══ 工艺总览卡 (12,52,1078,470)——管廊布线 T4.2/水池 T4.3/泵卡 T4.4 ═══ -->
            <controls:CardView Canvas.Left="12" Canvas.Top="52" Width="1078" Height="470" Title="工艺总览">
                <Canvas>
                    <!-- 水源段（细则 §4.1 过程卡内部表） -->
                    <TextBlock Canvas.Left="16" Canvas.Top="4" Text="蓄水池" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}" />
                    <controls:LevelTank Canvas.Left="16" Canvas.Top="20" Width="210" Height="156"
                                        Value="{ui:TagBinding CurWaterPos}"
                                        LowAt="{Binding ThresholdLow}"
                                        HighAt="{Binding ThresholdHigh}" />
                    <controls:ParaBox Canvas.Left="16" Canvas.Top="184" Title="水位" Unit="m" Decimals="1"
                                      Value="{ui:TagBinding CurWaterPos}"
                                      LowThreshold="{Binding ThresholdLow}"
                                      HighThreshold="{Binding ThresholdHigh}" />
                    <controls:ParaBox Canvas.Left="16" Canvas.Top="224" Title="主管压力" Unit="MPa" Decimals="2"
                                      Value="{ui:TagBinding MainOutPressure}"
                                      HighThreshold="{Binding ThresholdPressureMax}" />
                    <controls:ParaBox Canvas.Left="16" Canvas.Top="264" Title="主管流量" Unit="m³" Decimals="1"
                                      Value="{ui:TagBinding MainOutFlow}" />
                    <StackPanel Canvas.Left="16" Canvas.Top="312" Orientation="Horizontal">
                        <TextBlock Text="主阀门" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0" />
                        <controls:USwitchW SwitchState="{Binding ControlVm.SwitchStates[MainValve]}"
                                           Command="{Binding DataContext.ControlVm.ToggleCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="MainValve" />
                    </StackPanel>
                    <!-- ═══ 上管廊 y=16：主管与供水短柱（T4.2） ═══ -->
                    <TextBlock Canvas.Left="340" Canvas.Top="0" Text="主管（进水）" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" />
                    <controls:PipeLine Canvas.Left="226" Canvas.Top="13" Width="824" Height="6"
                                       Orientation="Horizontal" Direction="LeftToRight"
                                       Active="{Binding IsPipeMainActive}"
                                       Alarm="{Binding IsHighPressure}" />
                    <!-- 总阀门阀体示意（x=300，P&ID 双三角阀门符号） -->
                    <Path Canvas.Left="292" Canvas.Top="10" Data="M0,0 L16,12 L16,0 L0,12 Z"
                          Stroke="{DynamicResource Stroke}" StrokeThickness="1">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{DynamicResource Off}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPipeMainActive}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Ok}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <TextBlock Canvas.Left="284" Canvas.Top="24" Text="总阀门" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}" />

                    <!-- 供水短柱 1# 2# 3# (x=468, 714, 960, y: 16→36) -->
                    <controls:PipeLine Canvas.Left="465" Canvas.Top="16" Width="6" Height="20"
                                       Orientation="Vertical" Direction="TopToBottom"
                                       Active="{Binding IsPipeMainActive}" />
                    <controls:PipeLine Canvas.Left="711" Canvas.Top="16" Width="6" Height="20"
                                       Orientation="Vertical" Direction="TopToBottom"
                                       Active="{Binding IsPipeMainActive}" />
                    <controls:PipeLine Canvas.Left="957" Canvas.Top="16" Width="6" Height="20"
                                       Orientation="Vertical" Direction="TopToBottom"
                                       Active="{Binding IsPipeMainActive}" />

                    <!-- ═══ 1# 泵卡（卡中卡，240×356，设计书 §2.3 / T4.4） ═══ -->
                    <controls:CardView Canvas.Left="324" Canvas.Top="36" Width="240" Height="356" Title="1# 水泵">
                        <controls:CardView.Badge>
                            <controls:AlarmBadgeChip Value="{ui:TagBinding Pump1_Fault}"
                                                     ActiveText="▲ 故障" InactiveText=""
                                                     ActiveTone="Alarm" InactiveTone="Off" />
                        </controls:CardView.Badge>
                        <Canvas Width="218" Height="314">
                            <!-- 启停旋钮 -->
                            <controls:URotarySwitchW Canvas.Left="12" Canvas.Top="8"
                                                     SwitchState="{Binding ControlVm.SwitchStates[Pump1_Run]}"
                                                     Command="{Binding DataContext.ControlVm.ToggleCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="Pump1_Run" />
                            <TextBlock Canvas.Left="26" Canvas.Top="66" Text="启停" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" />

                            <!-- 泵图 -->
                            <controls:PumpGraphic Canvas.Left="88" Canvas.Top="4"
                                                  RunValue="{ui:TagBinding Pump1_Run}"
                                                  FaultValue="{ui:TagBinding Pump1_Fault}" />

                            <!-- F/P/S 键值三行 -->
                            <controls:ParaBox Canvas.Left="12" Canvas.Top="92" Title="频率" Unit="Hz" Decimals="1"
                                              Value="{ui:TagBinding Pump1_F}"
                                              AlarmValue="{ui:TagBinding Pump1_Fault}" />
                            <controls:ParaBox Canvas.Left="12" Canvas.Top="124" Title="功率" Unit="kW" Decimals="1"
                                              Value="{ui:TagBinding Pump1_P}"
                                              AlarmValue="{ui:TagBinding Pump1_Fault}" />
                            <controls:ParaBox Canvas.Left="12" Canvas.Top="156" Title="转速" Unit="r/m" Decimals="0"
                                              Value="{ui:TagBinding Pump1_S}"
                                              AlarmValue="{ui:TagBinding Pump1_Fault}" />

                            <!-- 双徽章 -->
                            <StackPanel Canvas.Left="12" Canvas.Top="194" Orientation="Horizontal">
                                <controls:AlarmBadgeChip Value="{ui:TagBinding Pump1_Run}"
                                                         ActiveText="● 运行" InactiveText="● 停止"
                                                         ActiveTone="Ok" InactiveTone="Off"
                                                         Margin="0,0,8,0" />
                                <controls:AlarmBadgeChip Value="{ui:TagBinding Pump1_Fault}"
                                                         ActiveText="▲ 故障" InactiveText="● 正常"
                                                         ActiveTone="Alarm" InactiveTone="Off" />
                            </StackPanel>

                            <!-- 控制开关：支管阀门与手自模式 -->
                            <StackPanel Canvas.Left="12" Canvas.Top="230" Orientation="Horizontal">
                                <TextBlock Text="支阀" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                                <controls:USwitchW SwitchState="{Binding ControlVm.SwitchStates[Valve1]}"
                                                   Command="{Binding DataContext.ControlVm.ToggleCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="Valve1" />
                            </StackPanel>
                            <StackPanel Canvas.Left="12" Canvas.Top="264" Orientation="Horizontal">
                                <TextBlock Text="手/自" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                                <controls:USwitchW SwitchState="{Binding ControlVm.SwitchStates[Pump1_Mode]}"
                                                   Command="{Binding DataContext.ControlVm.ToggleCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="Pump1_Mode" />
                            </StackPanel>
                        </Canvas>
                    </controls:CardView>

                    <!-- ═══ 2# 泵卡（卡中卡，240×356，设计书 §2.3 / T4.4） ═══ -->
                    <controls:CardView Canvas.Left="570" Canvas.Top="36" Width="240" Height="356" Title="2# 水泵">
                        <controls:CardView.Badge>
                            <controls:AlarmBadgeChip Value="{ui:TagBinding Pump2_Fault}"
                                                     ActiveText="▲ 故障" InactiveText=""
                                                     ActiveTone="Alarm" InactiveTone="Off" />
                        </controls:CardView.Badge>
                        <Canvas Width="218" Height="314">
                            <!-- 启停旋钮 -->
                            <controls:URotarySwitchW Canvas.Left="12" Canvas.Top="8"
                                                     SwitchState="{Binding ControlVm.SwitchStates[Pump2_Run]}"
                                                     Command="{Binding DataContext.ControlVm.ToggleCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="Pump2_Run" />
                            <TextBlock Canvas.Left="26" Canvas.Top="66" Text="启停" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" />

                            <!-- 泵图 -->
                            <controls:PumpGraphic Canvas.Left="88" Canvas.Top="4"
                                                  RunValue="{ui:TagBinding Pump2_Run}"
                                                  FaultValue="{ui:TagBinding Pump2_Fault}" />

                            <!-- F/P/S 键值三行 -->
                            <controls:ParaBox Canvas.Left="12" Canvas.Top="92" Title="频率" Unit="Hz" Decimals="1"
                                              Value="{ui:TagBinding Pump2_F}"
                                              AlarmValue="{ui:TagBinding Pump2_Fault}" />
                            <controls:ParaBox Canvas.Left="12" Canvas.Top="124" Title="功率" Unit="kW" Decimals="1"
                                              Value="{ui:TagBinding Pump2_P}"
                                              AlarmValue="{ui:TagBinding Pump2_Fault}" />
                            <controls:ParaBox Canvas.Left="12" Canvas.Top="156" Title="转速" Unit="r/m" Decimals="0"
                                              Value="{ui:TagBinding Pump2_S}"
                                              AlarmValue="{ui:TagBinding Pump2_Fault}" />

                            <!-- 双徽章 -->
                            <StackPanel Canvas.Left="12" Canvas.Top="194" Orientation="Horizontal">
                                <controls:AlarmBadgeChip Value="{ui:TagBinding Pump2_Run}"
                                                         ActiveText="● 运行" InactiveText="● 停止"
                                                         ActiveTone="Ok" InactiveTone="Off"
                                                         Margin="0,0,8,0" />
                                <controls:AlarmBadgeChip Value="{ui:TagBinding Pump2_Fault}"
                                                         ActiveText="▲ 故障" InactiveText="● 正常"
                                                         ActiveTone="Alarm" InactiveTone="Off" />
                            </StackPanel>

                            <!-- 控制开关：支管阀门与手自模式 -->
                            <StackPanel Canvas.Left="12" Canvas.Top="230" Orientation="Horizontal">
                                <TextBlock Text="支阀" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                                <controls:USwitchW SwitchState="{Binding ControlVm.SwitchStates[Valve2]}"
                                                   Command="{Binding DataContext.ControlVm.ToggleCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="Valve2" />
                            </StackPanel>
                            <StackPanel Canvas.Left="12" Canvas.Top="264" Orientation="Horizontal">
                                <TextBlock Text="手/自" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                                <controls:USwitchW SwitchState="{Binding ControlVm.SwitchStates[Pump2_Mode]}"
                                                   Command="{Binding DataContext.ControlVm.ToggleCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="Pump2_Mode" />
                            </StackPanel>
                        </Canvas>
                    </controls:CardView>

                    <!-- ═══ 3# 泵卡（卡中卡，240×356，设计书 §2.3 / T4.4） ═══ -->
                    <controls:CardView Canvas.Left="816" Canvas.Top="36" Width="240" Height="356" Title="3# 水泵">
                        <controls:CardView.Badge>
                            <controls:AlarmBadgeChip Value="{ui:TagBinding Pump3_Fault}"
                                                     ActiveText="▲ 故障" InactiveText=""
                                                     ActiveTone="Alarm" InactiveTone="Off" />
                        </controls:CardView.Badge>
                        <Canvas Width="218" Height="314">
                            <!-- 启停旋钮 -->
                            <controls:URotarySwitchW Canvas.Left="12" Canvas.Top="8"
                                                     SwitchState="{Binding ControlVm.SwitchStates[Pump3_Run]}"
                                                     Command="{Binding DataContext.ControlVm.ToggleCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="Pump3_Run" />
                            <TextBlock Canvas.Left="26" Canvas.Top="66" Text="启停" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" />

                            <!-- 泵图 -->
                            <controls:PumpGraphic Canvas.Left="88" Canvas.Top="4"
                                                  RunValue="{ui:TagBinding Pump3_Run}"
                                                  FaultValue="{ui:TagBinding Pump3_Fault}" />

                            <!-- F/P/S 键值三行 -->
                            <controls:ParaBox Canvas.Left="12" Canvas.Top="92" Title="频率" Unit="Hz" Decimals="1"
                                              Value="{ui:TagBinding Pump3_F}"
                                              AlarmValue="{ui:TagBinding Pump3_Fault}" />
                            <controls:ParaBox Canvas.Left="12" Canvas.Top="124" Title="功率" Unit="kW" Decimals="1"
                                              Value="{ui:TagBinding Pump3_P}"
                                              AlarmValue="{ui:TagBinding Pump3_Fault}" />
                            <controls:ParaBox Canvas.Left="12" Canvas.Top="156" Title="转速" Unit="r/m" Decimals="0"
                                              Value="{ui:TagBinding Pump3_S}"
                                              AlarmValue="{ui:TagBinding Pump3_Fault}" />

                            <!-- 双徽章 -->
                            <StackPanel Canvas.Left="12" Canvas.Top="194" Orientation="Horizontal">
                                <controls:AlarmBadgeChip Value="{ui:TagBinding Pump3_Run}"
                                                         ActiveText="● 运行" InactiveText="● 停止"
                                                         ActiveTone="Ok" InactiveTone="Off"
                                                         Margin="0,0,8,0" />
                                <controls:AlarmBadgeChip Value="{ui:TagBinding Pump3_Fault}"
                                                         ActiveText="▲ 故障" InactiveText="● 正常"
                                                         ActiveTone="Alarm" InactiveTone="Off" />
                            </StackPanel>

                            <!-- 控制开关：支管阀门与手自模式 -->
                            <StackPanel Canvas.Left="12" Canvas.Top="230" Orientation="Horizontal">
                                <TextBlock Text="支阀" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                                <controls:USwitchW SwitchState="{Binding ControlVm.SwitchStates[Valve3]}"
                                                   Command="{Binding DataContext.ControlVm.ToggleCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="Valve3" />
                            </StackPanel>
                            <StackPanel Canvas.Left="12" Canvas.Top="264" Orientation="Horizontal">
                                <TextBlock Text="手/自" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
                                <controls:USwitchW SwitchState="{Binding ControlVm.SwitchStates[Pump3_Mode]}"
                                                   Command="{Binding DataContext.ControlVm.ToggleCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="Pump3_Mode" />
                            </StackPanel>
                        </Canvas>
                    </controls:CardView>

                    <!-- ═══ 泵列管道层（y: 36..392，置顶以贯穿泵卡） ═══ -->
                    <controls:PipeLine Canvas.Left="465" Canvas.Top="36" Width="6" Height="356"
                                       Orientation="Vertical" Direction="TopToBottom"
                                       Panel.ZIndex="2"
                                       Active="{Binding IsPipePump1Active}" />
                    <controls:PipeLine Canvas.Left="711" Canvas.Top="36" Width="6" Height="356"
                                       Orientation="Vertical" Direction="TopToBottom"
                                       Panel.ZIndex="2"
                                       Active="{Binding IsPipePump2Active}" />
                    <controls:PipeLine Canvas.Left="957" Canvas.Top="36" Width="6" Height="356"
                                       Orientation="Vertical" Direction="TopToBottom"
                                       Panel.ZIndex="2"
                                       Active="{Binding IsPipePump3Active}" />

                    <!-- 出口短柱 1# 2# 3# (x=468, 714, 960, y: 392→416) -->
                    <controls:PipeLine Canvas.Left="465" Canvas.Top="392" Width="6" Height="24"
                                       Orientation="Vertical" Direction="TopToBottom"
                                       Panel.ZIndex="2"
                                       Active="{Binding IsPipePump1Active}" />
                    <controls:PipeLine Canvas.Left="711" Canvas.Top="392" Width="6" Height="24"
                                       Orientation="Vertical" Direction="TopToBottom"
                                       Panel.ZIndex="2"
                                       Active="{Binding IsPipePump2Active}" />
                    <controls:PipeLine Canvas.Left="957" Canvas.Top="392" Width="6" Height="24"
                                       Orientation="Vertical" Direction="TopToBottom"
                                       Panel.ZIndex="2"
                                       Active="{Binding IsPipePump3Active}" />

                    <!-- ═══ 下管廊 y=416：汇管与主管输出 ═══ -->
                    <controls:PipeLine Canvas.Left="465" Canvas.Top="413" Width="585" Height="6"
                                       Orientation="Horizontal" Direction="LeftToRight"
                                       Active="{Binding IsPipeMainActive}" />
                    <TextBlock Canvas.Left="960" Canvas.Top="424" Text="汇管 → 主管输出" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" />

                    <!-- ═══ 工艺图例（常驻过程卡左下角，设计书 §1.0/§2.2 自解释原则） ═══ -->
                    <Border Canvas.Left="16" Canvas.Top="358" Background="{DynamicResource BgHover}"
                            CornerRadius="4" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Line X1="0" Y1="6" X2="14" Y2="6" Stroke="{DynamicResource PipeRun}" StrokeThickness="3" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="流动" FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Line X1="0" Y1="6" X2="14" Y2="6" Stroke="{DynamicResource PipeIdle}" StrokeThickness="3" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="无水" FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Ok}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="运行/开" FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Alarm}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="故障" FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Off}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="停止/关" FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Canvas>
            </controls:CardView>

            <!-- ═══ 状态检测卡 (12,530,1078,110)——修 P5/P6 ═══ -->
            <controls:CardView Canvas.Left="12" Canvas.Top="530" Width="1078" Height="110" Title="状态检测">
                <ItemsControl ItemsSource="{Binding Badges}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Off}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ToneKey}" Value="Ok">
                                                        <Setter Property="Fill" Value="{DynamicResource Ok}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ToneKey}" Value="Alarm">
                                                        <Setter Property="Fill" Value="{DynamicResource Alarm}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Word}" FontSize="12" HorizontalAlignment="Center"
                                           Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Off}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ToneKey}" Value="Ok">
                                                    <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ToneKey}" Value="Alarm">
                                                    <Setter Property="Foreground" Value="{DynamicResource Alarm}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:CardView>

            <!-- ═══ 用水情况卡 (12,648,322,180) ═══ -->
            <controls:CardView Canvas.Left="12" Canvas.Top="648" Width="322" Height="180" Title="用水情况">
                <Grid Margin="8,10,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 完成率环 96×96 (24, 42) -->
                    <controls:RingGauge Grid.Column="0" Width="96" Height="96"
                                        Label="完成率" Unit="%" MinValue="0" MaxValue="100" Decimals="0"
                                        Value="{Binding WaterCompletionRate}"
                                        VerticalAlignment="Center" Margin="4,0,8,0" />
                    <!-- 计划/实际两行键值 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <controls:ParaBox Title="计划" Unit="m³" Decimals="1" Margin="0,0,0,10"
                                          Value="{ui:TagBinding PlanWaters}" />
                        <controls:ParaBox Title="实际" Unit="m³" Decimals="1"
                                          Value="{ui:TagBinding ActualWaters}" />
                    </StackPanel>
                </Grid>
            </controls:CardView>

            <!-- ═══ 趋势卡 (342,648,748,180)——修 P10 ═══ -->
            <controls:CardView Canvas.Left="342" Canvas.Top="648" Width="748" Height="180" Title="趋势曲线 · 蓄水池水位（5 分钟）">
                <controls:WaterTrendChart Snapshot="{Binding TrendSnapshot}"
                                          ThresholdLow="{Binding ThresholdLow}"
                                          ThresholdHigh="{Binding ThresholdHigh}"
                                          YMax="{Binding YMax}" />
            </controls:CardView>

            <!-- ═══ 实时报警卡 (1102,52,384,330)——修 P4/P12 ═══ -->
            <controls:CardView x:Name="AlarmCard" Canvas.Left="1102" Canvas.Top="52" Width="384" Height="330" Title="实时报警"
                               Focusable="True"
                               Badge="{Binding AlarmPanel.UnackBadgeText}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="2,2,2,6">
                        <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Alarm}"
                                   Text="{Binding AlarmPanel.UnackCount, StringFormat=⚠ 未确认 {0}}" />
                        <TextBlock Text="内容 / 触发 / 持续 / 状态（四态）" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </DockPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding AlarmPanel.Rows}"
                             SelectedItem="{Binding AlarmPanel.Selected}"
                             MouseDoubleClick="AlarmListBox_MouseDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BgHover}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ToneKey}" Value="Alarm">
                                                    <Setter Property="Background" Value="#40F87171" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ToneKey}" Value="Ack">
                                                    <Setter Property="Background" Value="#40FBBF24" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ToneKey}" Value="Recover">
                                                    <Setter Property="Background" Value="#40FB923C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Message}" FontSize="12"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   ToolTip="{Binding Message}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TriggeredText}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Grid.Column="3" Text="{Binding StateText}" FontSize="11"
                                                   FontWeight="SemiBold" TextAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Off}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ToneKey}" Value="Alarm">
                                                            <Setter Property="Foreground" Value="{DynamicResource Alarm}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ToneKey}" Value="Ack">
                                                            <Setter Property="Foreground" Value="{DynamicResource Ack}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ToneKey}" Value="Recover">
                                                            <Setter Property="Foreground" Value="{DynamicResource Recover}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="确认选中" Command="{Binding AlarmPanel.AckSelectedCommand}"
                                Width="88" Height="28" Margin="0,0,8,0" />
                        <Button Content="全部确认" Command="{Binding AlarmPanel.AckAllCommand}"
                                Width="88" Height="28" Background="{DynamicResource Accent}"
                                Foreground="{DynamicResource TextPrimary}" BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </controls:CardView>

            <!-- ═══ 环境数据卡 (1102,390,384,250)——环形仪表 T4.5（修 P7 量程对齐） ═══ -->
            <controls:CardView Canvas.Left="1102" Canvas.Top="390" Width="384" Height="250" Title="环境数据">
                <UniformGrid Columns="2" Rows="2" Margin="10,4,10,6">
                    <!-- 1. 温度: -10 ~ 50 ℃ -->
                    <controls:RingGauge Label="温度" Unit="℃" MinValue="-10" MaxValue="50" Decimals="1"
                                        Value="{ui:TagBinding CurTemperature}" />
                    <!-- 2. 土壤湿度: 0 ~ 100 % -->
                    <controls:RingGauge Label="土壤湿度" Unit="%" MinValue="0" MaxValue="100" Decimals="1"
                                        Value="{ui:TagBinding SoilHumidity}" />
                    <!-- 3. 降水量: 0 ~ 100 mm -->
                    <controls:RingGauge Label="降水量" Unit="mm" MinValue="0" MaxValue="100" Decimals="1"
                                        Value="{ui:TagBinding Precipitation}" />
                    <!-- 4. 实际用水: 0 ~ 500 m³（修 P7：0~500 量程下 85.4 指在 17% 位置） -->
                    <controls:RingGauge Label="实际用水" Unit="m³" MinValue="0" MaxValue="500" Decimals="1"
                                        Value="{ui:TagBinding ActualWaters}" />
                </UniformGrid>
            </controls:CardView>

            <!-- ═══ 通信控制卡 (1102,648,384,180)——两态（T3.3） ═══ -->
            <controls:CardView Canvas.Left="1102" Canvas.Top="648" Width="384" Height="180" Title="通信控制（Modbus TCP）">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,10">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Off}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnToneKey}" Value="Ok">
                                            <Setter Property="Fill" Value="{DynamicResource Ok}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnToneKey}" Value="Alarm">
                                            <Setter Property="Fill" Value="{DynamicResource Alarm}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnToneKey}" Value="Accent">
                                            <Setter Property="Fill" Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnStateText}" FontSize="14"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="IP" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBox Grid.Column="1" Text="{Binding IpText, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="端口" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBox Grid.Column="1" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                    </Grid>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding SimButtonText}" Command="{Binding ToggleSimCommand}"
                                Width="88" Height="30" Margin="0,0,8,0" />
                        <Button Content="断开" Command="{Binding DisconnectCommand}"
                                Width="72" Height="30" Margin="0,0,8,0" />
                        <Button Content="连接" Command="{Binding ConnectCommand}"
                                Width="72" Height="30" Background="{DynamicResource Accent}"
                                Foreground="{DynamicResource TextPrimary}" BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </controls:CardView>

            <!-- ═══ 运行日志卡 (0,836,1492,164)——T4.8 加高≥6行 + 列头防折行（P11 关闭） ═══ -->
            <Border Canvas.Left="0" Canvas.Top="836" Width="1492" Height="164"
                    Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Stroke}"
                    BorderThickness="1" CornerRadius="8">
                <Grid Margin="10,2,10,2">
                    <DataGrid x:Name="LogGrid" ItemsSource="{Binding Log.Entries}"
                              AutoGenerateColumns="False" HeadersVisibility="Column"
                              EnableRowVirtualization="False" IsReadOnly="True"
                              SelectionMode="Single" LoadingRow="LogGrid_LoadingRow"
                              RowHeight="22" ColumnHeaderHeight="26"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="100" />
                            <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="64" />
                            <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- 右上角 [F12 全量日志] 快捷入口（细则 §4.1 日志卡） -->
                    <Button Content="[F12 全量日志]" Click="OpenLogViewer_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,2,8,0" Height="22"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource Accent}" FontSize="11"
                            Cursor="Hand" />
                </Grid>
            </Border>
        </Canvas>
    </Viewbox>
</Window>
