<Window x:Class="WaterSystem.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WaterSystem.Wpf.Binding"
        xmlns:controls="clr-namespace:WaterSystem.Wpf.Controls"
        Title="智能水箱上位机"
        Width="1492" Height="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BgWindow}"
        FontFamily="微软雅黑">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="164" />
        </Grid.RowDefinitions>

        <!-- 顶栏（标题 + 拖动 + 关闭；状态带 M4 填充） -->
        <Grid Grid.Row="0" Background="{DynamicResource BgCard}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="智能水箱上位机" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="蓄水池 · 3 台水泵 · 阀门组监控" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" Margin="12,3,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="CloseButton" Content="✕" Width="32" Height="32"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,8,0" Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource TextSecondary}" FontSize="13"
                    Click="CloseButton_Click" />
        </Grid>

        <!-- 主内容区（M3 过渡布局：左数值区 / 右通信卡；下：状态徽章带；M4 按设计稿重排） -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="384" />
            </Grid.ColumnDefinitions>

            <!-- 左：实时数值（T3.4） + 控制操作（T5.1，开关视觉 OneWay + 手势命令） -->
            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,12,12"
                    Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Stroke}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="实时数值" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                               Margin="12,8,0,0" />
                    <Grid x:Name="ParaPanel" Margin="16">
                        <WrapPanel>
                            <controls:ParaBox Title="水位" Unit="m" Decimals="1" Margin="0,0,24,16"
                                              Value="{ui:TagBinding CurWaterPos}" />
                            <controls:ParaBox Title="主管压力" Unit="MPa" Decimals="2" Margin="0,0,24,16"
                                              Value="{ui:TagBinding MainOutPressure}" />
                            <controls:ParaBox Title="主管流量" Unit="m³" Decimals="1" Margin="0,0,24,16"
                                              Value="{ui:TagBinding MainOutFlow}" />
                            <controls:ParaBox Title="温度" Unit="℃" Decimals="1" Margin="0,0,24,16"
                                              Value="{ui:TagBinding CurTemperature}" />
                            <controls:ParaBox Title="湿度" Unit="%" Decimals="0" Margin="0,0,24,16"
                                              Value="{ui:TagBinding SoilHumidity}" />
                            <controls:ParaBox Title="降水" Unit="mm" Decimals="1" Margin="0,0,24,16"
                                              Value="{ui:TagBinding Precipitation}" />
                            <controls:ParaBox Title="1#频率" Unit="Hz" Decimals="0" Margin="0,0,24,16"
                                              Value="{ui:TagBinding Pump1_F}" />
                            <controls:ParaBox Title="1#功率" Unit="kW" Decimals="0" Margin="0,0,24,16"
                                              Value="{ui:TagBinding Pump1_P}" />
                            <controls:ParaBox Title="1#转速" Unit="r/min" Decimals="0"
                                              Value="{ui:TagBinding Pump1_S}" />
                        </WrapPanel>
                    </Grid>
                    <TextBlock Text="控制操作" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                               Margin="12,4,0,0" />
                    <ItemsControl Margin="12,6,12,10" ItemsSource="{Binding ControlVm.ControlItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgHover}" CornerRadius="6"
                                        Padding="10,6" Margin="0,0,10,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0" />
                                        <controls:USwitchW VerticalAlignment="Center"
                                                           SwitchState="{Binding State}"
                                                           Command="{Binding DataContext.ControlVm.ToggleCommand,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding Tag}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 右：通信控制卡（两态；T3.3） -->
            <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 状态行（dot 随 ConnToneKey 变色，P4/P13） -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,10">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Off}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnToneKey}" Value="Ok">
                                            <Setter Property="Fill" Value="{DynamicResource Ok}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnToneKey}" Value="Alarm">
                                            <Setter Property="Fill" Value="{DynamicResource Alarm}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnToneKey}" Value="Accent">
                                            <Setter Property="Fill" Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnStateText}" FontSize="14"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>

                    <!-- IP / 端口（标签与输入框同行左对齐，修 P3） -->
                    <Grid Grid.Row="1" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="IP" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBox Grid.Column="1" Text="{Binding IpText, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="端口" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBox Grid.Column="1" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                    </Grid>

                    <!-- 按钮行（互斥启用 + busy 态，修 P13；模拟/真机同一套命令） -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding SimButtonText}" Command="{Binding ToggleSimCommand}"
                                Width="88" Height="30" Margin="0,0,8,0" />
                        <Button Content="断开" Command="{Binding DisconnectCommand}"
                                Width="72" Height="30" Margin="0,0,8,0" />
                        <Button Content="连接" Command="{Binding ConnectCommand}"
                                Width="72" Height="30" Background="{DynamicResource Accent}"
                                Foreground="{DynamicResource TextPrimary}" BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 状态徽章带（T3.5：7 组，文字随状态变——修 P5/P6） -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Stroke}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                <ItemsControl ItemsSource="{Binding Badges}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Off}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ToneKey}" Value="Ok">
                                                        <Setter Property="Fill" Value="{DynamicResource Ok}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ToneKey}" Value="Alarm">
                                                        <Setter Property="Fill" Value="{DynamicResource Alarm}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Word}" FontSize="12" HorizontalAlignment="Center"
                                           Margin="0,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Off}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ToneKey}" Value="Ok">
                                                    <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ToneKey}" Value="Alarm">
                                                    <Setter Property="Foreground" Value="{DynamicResource Alarm}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
        <!-- 运行日志卡（T6.1：LogRowStyler 唯一出处着色；DEBUG 不进主卡，F12 窗口见全量） -->
        <Border Grid.Row="2" Margin="12,0,12,8"
                Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="1" CornerRadius="8">
            <Grid Margin="8,4,8,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="4,2,4,4">
                    <TextBlock DockPanel.Dock="Right" Text="F12 全量日志" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock Text="运行日志" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                </DockPanel>
                <DataGrid Grid.Row="1" x:Name="LogGrid" ItemsSource="{Binding Log.Entries}"
                          AutoGenerateColumns="False" HeadersVisibility="Column"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="Transparent"
                          Foreground="{DynamicResource TextPrimary}" FontSize="12"
                          RowHeight="22" ColumnHeaderHeight="26"
                          EnableRowVirtualization="False" IsReadOnly="True"
                          SelectionMode="Single" LoadingRow="LogGrid_LoadingRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="100" />
                        <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="64" />
                        <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
