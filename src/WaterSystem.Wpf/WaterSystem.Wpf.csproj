<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WaterSystem.Wpf</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\configFiles\TagTable.csv" Link="configFiles\TagTable.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\configFiles\AlarmConfig.json" Link="configFiles\AlarmConfig.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\configFiles\Communication.txt" Link="configFiles\Communication.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WaterSystem.Core\WaterSystem.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HandyControl" Version="3.5.1" />
  </ItemGroup>

</Project>
