<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色令牌（唯一出处：《UI人性化设计概要》v2.0 §4.4；修改令牌必须先改概要） -->
    <SolidColorBrush x:Key="BgWindow" Color="#0B1220" />
    <SolidColorBrush x:Key="BgCard" Color="#131C2E" />
    <SolidColorBrush x:Key="BgCardLabel" Color="#0E1626" />
    <SolidColorBrush x:Key="BgHover" Color="#1A2740" />
    <SolidColorBrush x:Key="Stroke" Color="#223047" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E5EDF5" />
    <SolidColorBrush x:Key="TextSecondary" Color="#8FA3BF" />
    <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
    <SolidColorBrush x:Key="Ok" Color="#34D399" />
    <SolidColorBrush x:Key="Off" Color="#64748B" />
    <SolidColorBrush x:Key="Alarm" Color="#F87171" />
    <SolidColorBrush x:Key="Ack" Color="#FBBF24" />
    <SolidColorBrush x:Key="Recover" Color="#FB923C" />
    <SolidColorBrush x:Key="WarnText" Color="#FBBF24" />
    <SolidColorBrush x:Key="PipeIdle" Color="#3D4E6B" />
    <SolidColorBrush x:Key="PipeRun" Color="#3FB950" />

    <!-- 基础控件暗色样式（T3.3 过渡版；T4.0 由 HandyControl 皮肤接管） -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgHover}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BgHover}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource BgCard}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource BgCard}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
</ResourceDictionary>
