<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:WaterSystem.Wpf.Controls">
    <!-- 深色令牌（唯一出处：《UI人性化设计概要》v2.0 §4.4；修改令牌必须先改概要） -->
    <SolidColorBrush x:Key="BgWindow" Color="#0B1220" />
    <SolidColorBrush x:Key="BgCard" Color="#131C2E" />
    <SolidColorBrush x:Key="BgCardLabel" Color="#0E1626" />
    <SolidColorBrush x:Key="BgHover" Color="#1A2740" />
    <SolidColorBrush x:Key="Stroke" Color="#223047" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E5EDF5" />
    <SolidColorBrush x:Key="TextSecondary" Color="#8FA3BF" />
    <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
    <SolidColorBrush x:Key="Ok" Color="#34D399" />
    <SolidColorBrush x:Key="Off" Color="#64748B" />
    <SolidColorBrush x:Key="Alarm" Color="#F87171" />
    <SolidColorBrush x:Key="Ack" Color="#FBBF24" />
    <SolidColorBrush x:Key="Recover" Color="#FB923C" />
    <SolidColorBrush x:Key="WarnText" Color="#FBBF24" />
    <SolidColorBrush x:Key="PipeIdle" Color="#3D4E6B" />
    <SolidColorBrush x:Key="PipeRun" Color="#3FB950" />

    <!-- 基础控件暗色样式（T3.3 过渡版；T4.0 由 HandyControl 皮肤接管） -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgHover}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BgHover}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource BgCard}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource BgCard}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource BgHover}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- 卡片容器（附录 B CardChrome：卡体 + 边线 + 卡底标签条） -->
    <Style TargetType="controls:CardView">
        <Setter Property="Background" Value="{StaticResource BgCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,4,10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CardView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0" Margin="{TemplateBinding Padding}" />
                            <Border Grid.Row="1" Background="{StaticResource BgCardLabel}">
                                <DockPanel Margin="12,0,12,0">
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                    <ContentPresenter Content="{TemplateBinding Badge}"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
